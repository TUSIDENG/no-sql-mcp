# Normalize all text files to LF on commit and checkout.
* text=auto eol=lf

# Explicit text types.
*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.ndjson   text eol=lf
Makefile   text eol=lf
.gitignore text eol=lf
