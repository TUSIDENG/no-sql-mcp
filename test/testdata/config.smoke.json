{
  "sources": [
    {
      "id": "logs_es_local",
      "type": "elasticsearch",
      "deployment_mode": "single",
      "addresses": ["http://localhost:9200"],
      "read_only": true
    },
    {
      "id": "cache_redis_local",
      "type": "redis",
      "deployment_mode": "cluster",
      "addresses": [
        "localhost:7000",
        "localhost:7001",
        "localhost:7002",
        "localhost:7003",
        "localhost:7004",
        "localhost:7005"
      ],
      "password": "${REDIS_PASSWORD}",
      "read_only": false
    },
    {
      "id": "events_kafka_local",
      "type": "kafka",
      "deployment_mode": "single",
      "brokers": ["localhost:9092"],
      "read_only": true
    }
  ]
}
